# Copy to .env.local (never commit .env.local).
# Talking Club admin API root incl. /api/v1 — QA server URL is in docs/hw3-plan.md.
NEXT_PUBLIC_API_BASE_URL=

# Optional: where the "Go to Talking Club home" button of the no-permission popup points.
# Empty = the button just closes the popup.
NEXT_PUBLIC_TC_HOME_URL=

# Optional: largest product image in MB (browser check, server check and the hint text). Empty = 4.
# Images go through this app's own server route (/api/upload); a Vercel function refuses request bodies
# above 4.5 MB, so keep 4 on Vercel. Read at build time: rebuild / redeploy after changing it.
NEXT_PUBLIC_MAX_IMAGE_MB=

# Optional, server only: the only S3 bucket /api/upload sends images to. Empty = talking-club-dev.
UPLOAD_S3_BUCKET=

# Playwright login (shared QA admin — the values come by DM, never put them in code or docs).
E2E_ADMIN_ID=
E2E_ADMIN_PASSWORD=
