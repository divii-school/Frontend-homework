# Copy to .env.local (never commit .env.local).
# Talking Club admin API root incl. /api/v1 — QA server URL is in docs/hw3-plan.md.
NEXT_PUBLIC_API_BASE_URL=

# Optional: where the "Go to Talking Club home" button of the no-permission popup points.
# Empty = the button just closes the popup.
NEXT_PUBLIC_TC_HOME_URL=

# Playwright login (shared QA admin — the values come by DM, never put them in code or docs).
E2E_ADMIN_ID=
E2E_ADMIN_PASSWORD=
